<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SectionTitle"
            android:text="Lieu de la météo" />

        <TextView
            android:id="@+id/current_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/search_field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#000000"
                android:hint="Ville (ex. Lyon)"
                android:imeOptions="actionSearch"
                android:inputType="textCapWords"
                android:textColor="#000000"
                android:textColorHint="#555555" />

            <Button
                android:id="@+id/search_button"
                style="@style/InkButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Rechercher" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/gps_button"
            style="@style/InkButton"
            android:layout_marginTop="12dp"
            android:text="Utiliser ma position actuelle" />

        <TextView
            style="@style/SectionTitle"
            android:text="Actualisation automatique" />

        <RadioGroup
            android:id="@+id/refresh_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton android:id="@+id/r15" style="@style/InkRadio" android:text="Toutes les 15 minutes" />
            <RadioButton android:id="@+id/r30" style="@style/InkRadio" android:text="Toutes les 30 minutes" />
            <RadioButton android:id="@+id/r60" style="@style/InkRadio" android:text="Toutes les heures" />
            <RadioButton android:id="@+id/r180" style="@style/InkRadio" android:text="Toutes les 3 heures" />
            <RadioButton android:id="@+id/r0" style="@style/InkRadio" android:text="Manuelle uniquement (toucher la météo du widget)" />
        </RadioGroup>

        <TextView
            style="@style/SectionTitle"
            android:text="Profil sonore (widget)" />

        <TextView
            android:id="@+id/dnd_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="15sp" />

        <Button
            android:id="@+id/dnd_button"
            style="@style/InkButton"
            android:layout_marginTop="8dp"
            android:text="Autoriser l'accès « Ne pas déranger »" />

        <Button
            android:id="@+id/refresh_button"
            style="@style/InkButton"
            android:layout_marginTop="20dp"
            android:text="Actualiser la météo maintenant" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#000000"
            android:textSize="15sp" />

        <Button
            android:id="@+id/done_button"
            style="@style/InkButton"
            android:layout_marginTop="20dp"
            android:text="Terminer"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Widget : appui long sur l'écran d'accueil → Widgets → « Heure, date et météo » (4×2).\nToucher l'heure ouvre ces réglages, toucher la météo l'actualise.\nDonnées météo : Open-Meteo.com"
            android:textColor="#000000"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
