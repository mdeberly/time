<?xml version="1.0" encoding="utf-8"?>
<!-- Carte d'alarme : grande heure, nom + jour du prochain déclenchement, interrupteur. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/card_pressable"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="#000000"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/item_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#000000"
            android:textSize="17sp" />
    </LinearLayout>

    <Switch
        android:id="@+id/item_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:thumbTint="@color/switch_thumb"
        android:trackTint="@color/switch_track"
        android:trackTintMode="src_over" />

    <ImageButton
        android:id="@+id/item_delete"
        style="@style/HeaderIcon"
        android:contentDescription="Supprimer"
        android:src="@drawable/ic_delete"
        android:visibility="gone" />
</LinearLayout>
