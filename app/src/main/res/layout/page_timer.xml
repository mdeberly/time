<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/timer_display"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:autoSizeMaxTextSize="96sp"
        android:autoSizeMinTextSize="40sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="00:00:00"
        android:textColor="#000000" />

    <LinearLayout
        android:id="@+id/timer_units"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView style="@style/TimerUnit" android:text="h" />
        <TextView style="@style/TimerUnit" android:text="min" />
        <TextView style="@style/TimerUnit" android:text="s" />
    </LinearLayout>

    <TextView
        android:id="@+id/timer_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#000000"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Roues heures / minutes / secondes, ligne sélectionnée encadrée -->
    <FrameLayout
        android:id="@+id/timer_pickers"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/picker_highlight" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <NumberPicker android:id="@+id/timer_h" style="@style/InkNumberPicker" />
            <NumberPicker android:id="@+id/timer_m" style="@style/InkNumberPicker" />
            <NumberPicker android:id="@+id/timer_s" style="@style/InkNumberPicker" />
        </LinearLayout>
    </FrameLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton android:id="@+id/timer_reset" style="@style/ControlIcon" android:contentDescription="Réinitialiser" android:src="@drawable/ic_reset" />
        <ImageButton android:id="@+id/timer_start" style="@style/ControlMain" android:contentDescription="Démarrer" android:src="@drawable/ic_play_circle" />
        <ImageButton android:id="@+id/timer_sound" style="@style/ControlIcon" android:contentDescription="Son du minuteur" android:src="@drawable/ic_bell" />
    </LinearLayout>
</LinearLayout>
