<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nouvelle alarme"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TimePicker
            android:id="@+id/time_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:theme="@style/InkPicker"
            android:timePickerMode="spinner" />

        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="12dp"
            android:text="Répétition" />

        <LinearLayout
            android:id="@+id/days_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/days_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#000000"
            android:textSize="14sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="Nom" />

        <EditText
            android:id="@+id/label_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#000000"
            android:hint="ex. Travail"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textColor="#000000"
            android:textColorHint="#555555" />

        <TextView
            style="@style/SectionTitle"
            android:text="Son de l'alarme" />

        <TextView
            android:id="@+id/sound_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="17sp" />

        <Button
            android:id="@+id/sound_system"
            style="@style/InkButton"
            android:layout_marginTop="10dp"
            android:text="Choisir une sonnerie du système" />

        <Button
            android:id="@+id/sound_file"
            style="@style/InkButton"
            android:layout_marginTop="8dp"
            android:text="Choisir un fichier audio (MP3…)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sound_test"
                style="@style/InkButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="▶ Écouter" />

            <Button
                android:id="@+id/sound_default"
                style="@style/InkButton"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Son par défaut" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="#000000"
            android:minHeight="44dp"
            android:text="Vibrer"
            android:textColor="#000000"
            android:textSize="16sp" />

        <Button
            android:id="@+id/save"
            style="@style/InkButtonFilled"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="Enregistrer" />

        <Button
            android:id="@+id/delete"
            style="@style/InkButton"
            android:layout_marginTop="12dp"
            android:text="Supprimer l'alarme" />
    </LinearLayout>
</ScrollView>
